<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingBottom="2dp"
    android:paddingEnd="@dimen/card_pad_h"
    android:paddingStart="@dimen/card_pad_h"
    android:paddingTop="6dp">

    <LinearLayout
        android:id="@+id/row_feature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/feature_icon"
            android:layout_width="@dimen/row_icon_size"
            android:layout_height="@dimen/row_icon_size"
            android:importantForAccessibility="no"
            android:tint="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginStart="@dimen/row_gap_icon_text"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/feature_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/row_title_size" />

            <TextView
                android:id="@+id/feature_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/row_summary_size" />

            <TextView
                android:id="@+id/feature_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.originui.replica.OriginSwitch
            android:id="@+id/feature_switch"
            android:layout_width="48dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <View
        android:id="@+id/feature_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="4dp"
        android:background="@color/divider"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/feature_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
