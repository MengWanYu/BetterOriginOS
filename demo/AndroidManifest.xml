<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.betteroriginos.vivouidemo"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VivoUI"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SettingsDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ClockActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ComponentsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".BlurLabActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MaterialGateActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ReplicaActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
    </application>
</manifest>
