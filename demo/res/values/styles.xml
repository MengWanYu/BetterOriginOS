<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VivoUI" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/vivo_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/vivo_accent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Anim.Vivo.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/vivo_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/vivo_dialog_out</item>
    </style>
    <style name="Anim.Vivo.Sheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/vivo_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/vivo_sheet_out</item>
    </style>
</resources>
